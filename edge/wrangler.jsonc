{
  // Template: copy this file, then replace every placeholder (routes, KV id, vars) with your own values before `wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cammut-edge-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Not needed: nodejs_compat (WebCrypto only). global_fetch_strictly_public is only for
  // URL-based client ids (CIMD), which stay off.
  "compatibility_flags": [],
  "workers_dev": false,
  "routes": [{ "pattern": "mcp.example.com", "custom_domain": true }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
  "vars": {
    "PUBLIC_ORIGIN": "https://mcp.example.com",
    "EDGE_AUD": "cammut-staging",
    "EDGE_KID": "edge-1",
    "APPWRITE_ENDPOINT": "https://fra.cloud.appwrite.io/v1",
    "APPWRITE_PROJECT_ID": "your-appwrite-project-id",
    "ALLOWED_GITHUB_IDS": "1234567",
    "ALLOWED_GOOGLE_EMAILS": "",
    "MCP_SERVERS": "github,hindsight,composio",
    "GITHUB_CLIENT_ID": "your-github-oauth-app-client-id",
    "ORIGIN_URL": "https://origin.example.com"
  },
  "observability": { "enabled": false }
}
