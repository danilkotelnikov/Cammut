#!/usr/bin/env bash
# Store an upstream secret on the VDS without it touching argv, shell history or chat.
#   cammut-secret GITHUB_PAT      -> prompts for the value (hidden), writes /root/private/cammut.env, restarts the gateway
set -euo pipefail
NAME="${1:?usage: cammut-secret NAME}"
[[ $NAME =~ ^[A-Z_][A-Z0-9_]{0,63}$ ]] || { echo "NAME must look like GITHUB_PAT" >&2; exit 2; }
ENVF=/root/private/cammut.env
[ -t 0 ] || { echo "run this in an interactive terminal; the value is read from the keyboard" >&2; exit 2; }
read -rsp "Value for $NAME (hidden): " VAL; echo
[ -n "$VAL" ] || { echo "empty value, nothing changed" >&2; exit 2; }
[[ $VAL != *$'\n'* && $VAL != *\'* && $VAL != *\"* && $VAL != *' '* ]] || { echo "value has spaces or quotes; paste the bare token" >&2; exit 2; }
umask 077
tmp=$(mktemp "$ENVF.XXXXXX")
{ grep -v "^${NAME}=" "$ENVF" || true; printf '%s=%s\n' "$NAME" "$VAL"; } > "$tmp"
mv "$tmp" "$ENVF"; chmod 600 "$ENVF"
cd /opt/cammut/deploy && docker compose up -d --force-recreate cammut >/dev/null
echo "saved $NAME and restarted the gateway"
